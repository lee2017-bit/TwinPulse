diff --git a/include/coin_d4_driver/scan_clock_contract.hpp b/include/coin_d4_driver/scan_clock_contract.hpp
new file mode 100644
--- /dev/null
+++ b/include/coin_d4_driver/scan_clock_contract.hpp
@@ -0,0 +1,61 @@
+// TwinPulse offline candidate; host sync receipt is NOT hardware calibration.
+#pragma once
+#include <cmath>
+#include <cstdint>
+#include <climits>
+#include <stdexcept>
+#include <vector>
+namespace robotis {namespace coin_d4 {
+struct ScanContract {
+  int64_t stamp_ns;
+  double first_angle, last_angle, angle_increment, time_increment;
+};
+inline ScanContract scan_contract(uint64_t start, uint64_t end, uint64_t now,
+  int64_t ros_now, const std::vector<double> & angles, int64_t previous_offset)
+{
+  constexpr double tau = 6.2831853071795864769;
+  if (angles.size() < 2 || angles.size() > 720) {
+    throw std::runtime_error("SCAN_COUNT_UNSUPPORTED");
+  }
+  if (start == 0 || end <= start || now < end || now > INT64_MAX ||
+    now - start > 2000000000ULL || ros_now <= 0) {
+    throw std::runtime_error("SCAN_CLOCK_DOMAIN_WRAP_OR_LATENCY");
+  }
+  const auto elapsed = static_cast<int64_t>(now - start);
+  if (ros_now < elapsed) {throw std::runtime_error("SCAN_ROS_CLOCK_UNDERFLOW");}
+  const auto offset = ros_now - static_cast<int64_t>(now);
+  if (previous_offset != INT64_MIN &&
+    std::abs(static_cast<long double>(offset) - previous_offset) > 50000000.L) {
+    throw std::runtime_error("SCAN_ROS_CLOCK_JUMP");
+  }
+  std::vector<double> unwrapped;
+  for (const auto a : angles) {
+    if (!std::isfinite(a) || a < 0 || a > tau) {
+      throw std::runtime_error("SCAN_ANGLE_NONFINITE_OR_RANGE");
+    }
+    if (unwrapped.empty()) {unwrapped.push_back(a);} else {
+      const auto previous = unwrapped.back();
+      const auto delta = std::atan2(std::sin(a - previous), std::cos(a - previous));
+      unwrapped.push_back(previous + delta);
+    }
+  }
+  const auto step = (unwrapped.back() - unwrapped.front()) / (angles.size() - 1);
+  if (!std::isfinite(step) || std::abs(step) < 1e-6 || std::abs(step) > 0.1 ||
+    std::abs(step) * (angles.size() - 1) > tau + .001) {
+    throw std::runtime_error("SCAN_ANGLE_ORDER_OR_SPAN");
+  }
+  for (size_t i = 1; i < angles.size(); ++i) {
+    if ((unwrapped[i] - unwrapped[i-1]) * step <= 0 ||
+      std::abs(unwrapped[i] - (unwrapped[0] + i * step)) > .002) {
+      throw std::runtime_error("SCAN_NONUNIFORM_BEAM_GRID");
+    }
+  }
+  return {ros_now - elapsed, unwrapped.front(), unwrapped.back(), step,
+    static_cast<double>(end - start) / (1e9 * angles.size())};
+}
+// Positive per-index time follows original array acquisition order. Signed
+// angular increment permits clockwise data without reversing time or ranges.
+// Reject reverse=true rather than silently preserving wrong beam timestamps.
+// The host-sync bridge is only a candidate. It is not a physical first-ray
+// timing assertion; measured sensor latency and axes are still required.
+}}  // namespace robotis::coin_d4
