#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
        string twinpulseModification = "TwinPulse 2026: removed exporter documentation with local paths; geometry, physics and relative references preserved. ROBOTIS origin and Apache-2.0 notice: ../SOURCE.json and ../ROBOTIS-LICENSE."
    }
    defaultPrim = "turtlebot3_burger"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "turtlebot3_burger" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
    }
    append variantSets = "Physics"
)
{
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
}

