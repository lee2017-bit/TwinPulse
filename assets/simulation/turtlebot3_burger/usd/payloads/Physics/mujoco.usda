#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
        string twinpulseModification = "TwinPulse 2026: removed exporter documentation with local paths; geometry, physics and relative references preserved. ROBOTIS origin and Apache-2.0 notice: ../SOURCE.json and ../ROBOTIS-LICENSE."
    }
    defaultPrim = "turtlebot3_burger"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "turtlebot3_burger"
{
    over "Physics"
    {
        def MjcActuator "wheel_left_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </turtlebot3_burger/Physics/wheel_left_joint>
        }

        def MjcActuator "wheel_right_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </turtlebot3_burger/Physics/wheel_right_joint>
        }

        over "wheel_left_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        over "wheel_right_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        over "caster_back_joint"
        {
        }

        over "scan_joint"
        {
        }
    }

    over "Geometry"
    {
        over "base_footprint"
        {
            over "base_link"
            {
                over "wheel_left_link"
                {
                    over "left_tire"
                    {
                    }

                    over "cylinder"
                    {
                    }
                }

                over "wheel_right_link"
                {
                    over "right_tire"
                    {
                    }

                    over "cylinder"
                    {
                    }
                }

                over "base_scan"
                {
                    over "lds"
                    {
                    }

                    over "cylinder"
                    {
                    }
                }

                over "caster_back_link"
                {
                    over "box"
                    {
                    }
                }

                over "imu_link"
                {
                }

                over "burger_base"
                {
                }

                over "box"
                {
                }
            }
        }
    }

    over "Materials"
    {
    }

    over "VisualMaterials"
    {
    }
}

