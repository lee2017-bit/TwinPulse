#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
        string twinpulseModification = "TwinPulse 2026: removed exporter documentation with local paths; geometry, physics and relative references preserved. ROBOTIS origin and Apache-2.0 notice: ../SOURCE.json and ../ROBOTIS-LICENSE."
    }
    defaultPrim = "turtlebot3_burger"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "turtlebot3_burger"
{
    over "Geometry"
    {
        over "base_footprint"
        {
            over "base_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI"]
            )
            {
                bool newton:selfCollisionEnabled = 0
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.0020005896, 0.0021177754, 0.002219874)
                float physics:mass = 0.82573503
                quatf physics:principalAxes = (0.6455786, 0.05095918, 0.7609015, 0.04074667)

                over "wheel_left_link" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    point3f physics:centerOfMass = (0, 0, 0)
                    float3 physics:diagonalInertia = (0.000011175576, 0.000011192413, 0.000020712561)
                    float physics:mass = 0.02849894
                    quatf physics:principalAxes = (0.99999917, -3.6310576e-7, 0.00031132408, -0.0012585121)

                    over "cylinder" (
                        prepend apiSchemas = ["NewtonCollisionAPI"]
                    )
                    {
                    }
                }

                over "wheel_right_link" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    point3f physics:centerOfMass = (0, 0, 0)
                    float3 physics:diagonalInertia = (0.000011175576, 0.000011192413, 0.000020712561)
                    float physics:mass = 0.02849894
                    quatf physics:principalAxes = (0.99999917, -3.6310576e-7, 0.00031132408, -0.0012585121)

                    over "cylinder" (
                        prepend apiSchemas = ["NewtonCollisionAPI"]
                    )
                    {
                    }
                }

                over "base_scan" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    point3f physics:centerOfMass = (0, 0, 0)
                    float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
                    float physics:mass = 0.114
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "cylinder" (
                        prepend apiSchemas = ["NewtonCollisionAPI"]
                    )
                    {
                    }
                }

                over "box" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }

                over "caster_back_link" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    point3f physics:centerOfMass = (0, 0, 0)
                    float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
                    float physics:mass = 0.005
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "box" (
                        prepend apiSchemas = ["NewtonCollisionAPI"]
                    )
                    {
                    }
                }
            }
        }
    }

    over "Physics"
    {
        def PhysicsRevoluteJoint "wheel_left_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:stiffness = 0
            uniform token physics:axis = "Z"
            custom rel physics:body0
            prepend rel physics:body0 = </turtlebot3_burger/Geometry/base_footprint/base_link>
            custom rel physics:body1
            prepend rel physics:body1 = </turtlebot3_burger/Geometry/base_footprint/base_link/wheel_left_link>
            point3f physics:localPos0 = (0, 0.08, 0.023)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.7073883, -0.7068252, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "wheel_right_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:stiffness = 0
            uniform token physics:axis = "Z"
            custom rel physics:body0
            prepend rel physics:body0 = </turtlebot3_burger/Geometry/base_footprint/base_link>
            custom rel physics:body1
            prepend rel physics:body1 = </turtlebot3_burger/Geometry/base_footprint/base_link/wheel_right_link>
            point3f physics:localPos0 = (0, -0.08, 0.023)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.7073883, -0.7068252, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "caster_back_joint"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </turtlebot3_burger/Geometry/base_footprint/base_link>
            custom rel physics:body1
            prepend rel physics:body1 = </turtlebot3_burger/Geometry/base_footprint/base_link/caster_back_link>
            point3f physics:localPos0 = (-0.081, 0, -0.004)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.7073883, -0.7068252, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "scan_joint"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </turtlebot3_burger/Geometry/base_footprint/base_link>
            custom rel physics:body1
            prepend rel physics:body1 = </turtlebot3_burger/Geometry/base_footprint/base_link/base_scan>
            point3f physics:localPos0 = (-0.032, 0, 0.172)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

