#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
        string twinpulseModification = "TwinPulse 2026: removed exporter documentation with local paths; geometry, physics and relative references preserved. ROBOTIS origin and Apache-2.0 notice: ../SOURCE.json and ../ROBOTIS-LICENSE."
    }
    defaultPrim = "turtlebot3_burger"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "turtlebot3_burger"
{
    over "Physics"
    {
        over "wheel_left_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "wheel_right_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

